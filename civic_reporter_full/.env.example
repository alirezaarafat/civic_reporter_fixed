# Copy to .env for local development; never commit real secrets.
DEBUG=true
SECRET_KEY=local-only-replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,https://your-username.github.io
# Production: set DEBUG=false and use a secret from your hosting provider.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com
